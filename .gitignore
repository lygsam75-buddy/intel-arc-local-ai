# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 编辑器
.vscode/
.idea/
*.swp

# 大文件不进仓库（模型、构建产物）
*.gguf
*.bin
*.exe
*.zip

# 日志默认排除……
*.log
